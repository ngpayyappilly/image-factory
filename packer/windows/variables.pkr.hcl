# Windows variables (AWS + Azure). Generated by `imagefactory packer-vars`.
variable "flavor" {
  type    = string
  default = "win2022"
}
variable "image_version" {
  type    = string
  default = "win2022-00000000.0"
}
variable "baseline_version" {
  type    = string
  default = "0.0.0"
}
variable "git_commit" {
  type    = string
  default = "unknown"
}
variable "cis_role" {
  type    = string
  default = ""
}
variable "architecture" {
  type        = string
  description = "CPU architecture of this flavor: x86_64 or arm64 (AWS naming)"
  default     = "x86_64"
}
variable "tool_urls" {
  type        = map(map(string))
  description = "Pinned URLs by architecture then tool: {x86_64 = {goss = ..., trivy = ..., syft = ...}, arm64 = {...}}"
  default     = {}
}
variable "tool_sha256" {
  type        = map(map(string))
  description = "SHA256 for every entry in tool_urls, same shape; scripts refuse unverified binaries"
  default     = {}
}
variable "report_dir" {
  type    = string
  default = "artifacts/reports"
}
variable "manifest_path" {
  type    = string
  default = "artifacts/packer-manifest.json"
}

variable "aws_regions" {
  type    = list(string)
  default = ["us-east-1"]
}
variable "aws_source_ami_name" {
  type    = string
  default = "Windows_Server-2022-English-Full-Base-*"
}
variable "aws_source_ami_owner" {
  type    = string
  default = "amazon"
}
variable "aws_ssh_user" {
  type    = string
  default = ""
}
variable "aws_instance_type" {
  type    = string
  default = "t3.large"
}
variable "aws_ami_users" {
  type    = list(string)
  default = []
}
variable "aws_vpc_id" {
  type    = string
  default = ""
}
variable "aws_subnet_id" {
  type    = string
  default = ""
}
variable "aws_ssh_interface" {
  type    = string
  default = ""
}
variable "aws_sg_source_public_ip" {
  type        = bool
  description = "Open the temporary security group only to the runner's public IP (use with GitHub-hosted runners)"
  default     = false
}
variable "aws_kms_key_id" {
  type    = string
  default = ""
}
variable "aws_region_kms_key_ids" {
  type    = map(string)
  default = {}
}

variable "azure_subscription_id" {
  type    = string
  default = ""
}
variable "azure_build_resource_group" {
  type    = string
  default = ""
}
variable "azure_gallery_resource_group" {
  type    = string
  default = ""
}
variable "azure_gallery_name" {
  type    = string
  default = ""
}
variable "azure_replication_regions" {
  type    = list(string)
  default = []
}
variable "azure_image_publisher" {
  type    = string
  default = ""
}
variable "azure_image_offer" {
  type    = string
  default = ""
}
variable "azure_image_sku" {
  type    = string
  default = ""
}
variable "azure_vm_size" {
  type    = string
  default = "Standard_D4s_v5"
}
variable "azure_image_version" {
  type    = string
  default = "0.0.0"
}
