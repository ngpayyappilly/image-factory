# Generated by `imagefactory packer-vars`; every variable has a default so that
# `packer validate -only=<one platform>` works without the other platforms' settings.

# --- common -------------------------------------------------------------------------------
variable "flavor" {
  type    = string
  default = "al2023"
}
variable "image_version" {
  type        = string
  description = "<flavor>-<YYYYMMDD>.<build>, from `imagefactory version-next`"
  default     = "al2023-00000000.0"
}
variable "baseline_version" {
  type    = string
  default = "0.0.0"
}
variable "git_commit" {
  type    = string
  default = "unknown"
}
variable "architecture" {
  type        = string
  description = "CPU architecture of this flavor: x86_64 or arm64 (AWS naming)"
  default     = "x86_64"
}
variable "cis_role" {
  type        = string
  description = "ansible-lockdown role name for this flavor, e.g. AMAZON2023-CIS"
  default     = ""
}
variable "distro_releasever" {
  type        = string
  description = "Pin the distro repository snapshot (Amazon Linux 2023 releasever). Empty = latest."
  default     = ""
}
variable "tool_urls" {
  type        = map(map(string))
  description = "Pinned URLs by architecture then tool: {x86_64 = {goss = ..., trivy = ..., syft = ...}, arm64 = {...}}"
  default     = {}
}
variable "tool_sha256" {
  type        = map(map(string))
  description = "SHA256 for every entry in tool_urls, same shape; scripts refuse unverified binaries"
  default     = {}
}
variable "report_dir" {
  type        = string
  description = "Where gate evidence (goss, trivy, sbom) is downloaded"
  default     = "artifacts/reports"
}
variable "manifest_path" {
  type    = string
  default = "artifacts/packer-manifest.json"
}

# --- aws ----------------------------------------------------------------------------------
variable "aws_regions" {
  type    = list(string)
  default = ["us-east-1"]
}
variable "aws_source_ami_name" {
  type    = string
  default = "al2023-ami-2023.*-kernel-6.18-x86_64"
}
variable "aws_source_ami_owner" {
  type    = string
  default = "amazon"
}
variable "aws_ssh_user" {
  type    = string
  default = "ec2-user"
}
variable "aws_instance_type" {
  type    = string
  default = "t3.medium"
}
variable "aws_ami_users" {
  type    = list(string)
  default = []
}
variable "aws_vpc_id" {
  type    = string
  default = ""
}
variable "aws_subnet_id" {
  type    = string
  default = ""
}
variable "aws_ssh_interface" {
  type    = string
  default = ""
}
variable "aws_sg_source_public_ip" {
  type        = bool
  description = "Open the temporary security group only to the runner's public IP (use with GitHub-hosted runners)"
  default     = false
}
variable "aws_kms_key_id" {
  type    = string
  default = ""
}
variable "aws_region_kms_key_ids" {
  type    = map(string)
  default = {}
}

